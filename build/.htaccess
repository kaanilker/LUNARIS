# LUNARIS: cPanel (Apache) için temiz adresler. Sahip belge: docs/mimari.md §7.
# Derleme her sayfayı klasör içinde index.html olarak üretir (/tr/planla/index.html);
# Apache bunları kural gerektirmeden sunar. Yalnız önceden üretilemeyen parsel adresleri
# (/tr/site/<parsel>/) istemci yedeği 200.html'e düşer.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
<IfModule mod_mime.c>
	AddType model/gltf-binary .glb
</IfModule>

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Dosya ya da klasör varsa olduğu gibi sun.
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	# Parsel sayfaları: istemci yönlendiricisi açar.
	RewriteRule ^(tr|en)/site/[^/]+/?$ /200.html [L]
</IfModule>

# Bilinmeyen adres: istemci yedeği hata sayfasını çizer, durum kodu 404 kalır.
ErrorDocument 404 /200.html

<IfModule mod_headers.c>
	# Derleme çıktısındaki adları içerik özetiyle değişen dosyalar uzun süre önbellekte kalabilir.
	<If "%{REQUEST_URI} =~ m#^/_app/immutable/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
	# Veri paketi: sürüm adı içerikten türer (hat/lunaris_hat/paket.py); işaretçi dosya her seferinde doğrulanır.
	<If "%{REQUEST_URI} =~ m#^/veri/[^/]+/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
	<If "%{REQUEST_URI} == '/veri/guncel.json'">
		Header set Cache-Control "no-cache"
	</If>
	# Araç modeli: dosya adı içerik özetini taşır (arac.<özet>.min.glb), değişince ad değişir.
	<If "%{REQUEST_URI} =~ m#^/sim/[^/]+\.glb$#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
	Header set X-Content-Type-Options "nosniff"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
